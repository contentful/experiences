{
  "name": "@implementation/experiences-nextjs-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone Next.js server reference for Contentful Experiences",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "dev": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev --hostname 127.0.0.1 --port 3500",
    "start": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next start --hostname 127.0.0.1 --port 3500",
    "serve": "npm run build && NEXT_IGNORE_INCORRECT_LOCKFILE=1 pm2 start ./node_modules/next/dist/bin/next --name experiences-nextjs-sdk-app -- start --hostname 127.0.0.1 --port 3500",
    "serve:stop": "pm2 delete experiences-nextjs-sdk-app",
    "restart": "npm run build && NEXT_IGNORE_INCORRECT_LOCKFILE=1 pm2 restart experiences-nextjs-sdk-app --update-env",
    "status": "pm2 show experiences-nextjs-sdk-app",
    "logs": "pm2 logs experiences-nextjs-sdk-app",
    "clean": "rimraf ./.next ./out ./tsconfig.tsbuildinfo",
    "lint": "eslint --config eslint.config.ts .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@contentful/experiences-nextjs": "file:../../pkgs/contentful-experiences-nextjs-local.tgz",
    "@contentful/experiences-node": "file:../../pkgs/contentful-experiences-node-local.tgz",
    "@contentful/experiences-react": "file:../../pkgs/contentful-experiences-react-local.tgz",
    "@contentful/experiences-web": "file:../../pkgs/contentful-experiences-web-local.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@contentful/rich-text-react-renderer": "16.1.6",
    "@contentful/rich-text-types": "17.2.7",
    "next": "15.5.28",
    "server-only": "0.0.1",
    "dotenv": "17.4.2",
    "html-react-parser": "6.1.9"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "pm2": "7.0.4",
    "rimraf": "6.1.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "jiti": "2.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "contentful": "11.12.10"
  },
  "overrides": {
    "@contentful/experiences-nextjs": "$@contentful/experiences-nextjs",
    "@contentful/experiences-node": "$@contentful/experiences-node",
    "@contentful/experiences-react": "$@contentful/experiences-react",
    "@contentful/experiences-web": "$@contentful/experiences-web",
    "@contentful/experiences-client": "file:../../pkgs/contentful-experiences-client-local.tgz",
    "@contentful/experiences-runtime": "file:../../pkgs/contentful-experiences-runtime-local.tgz",
    "@contentful/experiences-sdk-core": "file:../../pkgs/contentful-experiences-sdk-core-local.tgz",
    "@contentful/experiences-design": "file:../../pkgs/contentful-experiences-design-local.tgz",
    "@contentful/experiences-live-preview": "$@contentful/experiences-live-preview"
  },
  "nx": {
    "includedScripts": []
  },
  "optionalDependencies": {
    "@contentful/experiences-live-preview": "file:../../pkgs/contentful-experiences-live-preview-local.tgz"
  }
}
