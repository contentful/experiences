# Never put credentials in this tracked file. CDA_TOKEN stays server-only.
SPACE_ID=
ENVIRONMENT_ID=master
CDA_TOKEN=
# Optional explicitly browser-approved Delivery credential; blank uses the same-app proxy.
BROWSER_CDA_TOKEN=
LOCALE=en-US
# Trusted public origin for request page context; match the chosen hosting port.
ORIGIN=http://localhost:3500
# Optional comma-separated overrides; blank uses the shared reference IDs.
EXPERIENCE_IDS=
# Optional Destination routes; blank DESTINATION_ID shows them as not configured.
DESTINATION_ID=
# Optional overrides; blank uses /coded, sdk-ci-personalized, /legacy and /missing.
DESTINATION_PATH=
DESTINATION_NODE_ID=
DESTINATION_REDIRECT_PATH=
DESTINATION_MISSING_PATH=
# Optional server preview configuration; package loading remains conditional.
LIVE_PREVIEW_ENABLED=
PREVIEW_TOKEN=
PREVIEW_HOST=
# Separate browser-approved Preview credential; PREVIEW_TOKEN stays private.
BROWSER_PREVIEW_TOKEN=
BROWSER_PREVIEW_HOST=
LIVE_PREVIEW_EXPERIENCE_ID=
# Local convenience only; copy into preview_session_id in the URL. Code does not read it.
LIVE_PREVIEW_SESSION_ID=
LIVE_PREVIEW_SESSION_HOST=
LIVE_PREVIEW_RESOURCE_RESOLUTION=
