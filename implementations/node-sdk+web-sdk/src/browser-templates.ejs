<!-- Reference app: fixed browser presentation markup; dynamic CMS/event values
     use text APIs or Contentful's Rich Text renderer. No duplicate content schema. -->
<template id="tpl-card">
  <article class="entry-card">
    <h3></h3>
    <p></p>
    <div class="rich-text"></div>
  </article>
</template>
<template id="tpl-experience">
  <section class="entry-grid">
    <div class="entry-card__ids">
      <span class="entry-card__id-label">Experience</span>
      <span class="entry-card__id-value"></span>
    </div>
    <p class="page-status" role="status" data-partial hidden></p>
    <p data-empty>This Experience has no content.</p>
  </section>
</template>
<template id="tpl-route-header">
  <header class="page-header">
    <h1></h1>
    <p class="page-header__subtitle">Contentful Experiences · Node + Web SDK</p>
  </header>
</template>
<template id="tpl-content">
  <div id="content-error" data-testid="content-error" hidden></div>
  <section class="page-section" aria-label="Automatically observed Experiences">
    <header class="page-section__header">
      <h2>Automatically observed Experiences</h2>
      <p>Server or client markup carries real plan attribution. The SDK measures permitted views, clicks and hovers.</p>
    </header>
    <div class="entry-grid entry-grid--experiences" data-experiences="auto"></div>
  </section>
  <section class="page-section" aria-label="Manually observed Experiences">
    <header class="page-section__header">
      <h2>Manually observed Experiences</h2>
      <p>Elements register their real attribution after insertion. The SDK measures permitted views; this presentation has no automatic scope attributes.</p>
    </header>
    <div class="entry-grid entry-grid--experiences" data-experiences="manual"></div>
  </section>
</template>
<template id="tpl-status">
  <div class="placeholder-card">
    <p role="status"></p>
    <button type="button" class="btn btn--secondary" data-testid="retry-experiences-button" hidden>Retry content</button>
  </div>
</template>
<template id="tpl-custom-action">
  <section class="control-panel__actions" aria-label="Custom event" data-custom-action>
    <button type="button" class="btn btn--secondary" data-testid="track-custom-action-button">Record custom action</button>
    <p class="control-panel__note" role="status"></p>
  </section>
</template>
