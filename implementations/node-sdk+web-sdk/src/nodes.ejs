<% nodes.forEach((node, index) => {
  const nodeIdentity = `${identity}-${index}`;
  // Reference app: no registration defaults or resolveData hooks are configured.
  // Preserve the public precedence and actual named slots, without inferred nesting.
  const props = { ...node.props.design, ...node.props.content, ...node.props.resolved, ...node.slots };
  const registered = (node.registration.kind === 'component' && node.registration.id === 'codedComponent') ||
    (node.registration.kind === 'experienceTemplate' && node.registration.id === 'codedExperienceTemplate');
  const roots = node.attribution?.roots ?? [];
  const manualRoot = roots.at(-1);
%>
  <article class="entry-card<%= slotName === undefined ? '' : ' entry-card--slotted' %>"
    data-testid="content-<%= nodeIdentity %>"
    data-registration-kind="<%= node.registration.kind %>" data-registration-id="<%= node.registration.id %>"
    <% if (node.nodeId) { %>data-node-id="<%= node.nodeId %>"<% } %>
    <% if (automatic) { for (const [name, value] of Object.entries(getTrackingAttributes(node.attribution))) { %>
      <%= name %>="<%= value %>"
    <% } if (roots.some((scope) => scope.entityKind === 'ExperienceFragment')) { %>
      <%= TRACKING_CLICKABLE_ATTRIBUTE %>="true"
    <% } } else if (manualRoot) { %>
      data-reference-view-attribution="<%= JSON.stringify(manualRoot) %>"
    <% } %>>
    <% if (slotName !== undefined) { %>
      <span class="entry-card__badge entry-card__badge--slot">Slot: <%= slotName %></span>
    <% } %>
    <% if (registered) { %>
      <h3><%= props.title ?? '' %></h3>
      <p data-testid="experience-text-<%= nodeIdentity %>"><%= props.text ?? '' %></p>
      <% if (props.richText?.document) { %>
        <div class="rich-text"><%- documentToHtmlString(props.richText.document) %></div>
      <% } %>
    <% } else { %>
      <p>Unregistered <%= node.registration.kind %>: <%= node.registration.id %></p>
    <% } %>
    <% for (const [name, children] of Object.entries(node.slots)) { %>
      <div class="entry-card__nested-children" data-slot="<%= name %>">
        <%- include('nodes', { nodes: children, identity: `${nodeIdentity}-${name}`, automatic, slotName: name }) %>
      </div>
    <% } %>
  </article>
<% }); %>
