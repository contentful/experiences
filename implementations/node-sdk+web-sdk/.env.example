# Implementation-local runtime configuration; replace these public delivery placeholders.
SPACE_ID=your-space-id
CDA_TOKEN=your-browser-visible-delivery-token
ENVIRONMENT_ID=master
LOCALE=en-US
PORT=3300
# Optional comma-separated content IDs; blank uses the three shared reference IDs.
EXPERIENCE_IDS=

# Optional Destination demonstration (space-scoped; no environment or locale).
# These resolved values are browser-visible through the explicit configuration allowlist.
# Blank DESTINATION_ID keeps the app unchanged and /destination shows "not configured".
DESTINATION_ID=
# Optional overrides; blank uses the defaults shown.
# DESTINATION_PATH=/getting-started
# DESTINATION_NODE_ID=spring-offers
# DESTINATION_REDIRECT_PATH=/quick-start
# DESTINATION_MISSING_PATH=/retired-page

# Preview requires exactly true plus a nonempty trimmed URL preview_session_id.
LIVE_PREVIEW_ENABLED=
# Local convenience storage only; runtime/build code never reads or exposes this session ID.
LIVE_PREVIEW_SESSION_ID=
# URL preview_experience_id overrides this; blank binds the first configured/default ID.
LIVE_PREVIEW_EXPERIENCE_ID=
# Optional session-owned resource resolution; no per-fetch locale/parameter overrides.
LIVE_PREVIEW_RESOURCE_RESOLUTION=
# Server-only preview credential. Never serialized into HTML.
PREVIEW_TOKEN=
# Optional absolute HTTP(S) preview snapshot endpoint; blank uses the SDK default.
PREVIEW_HOST=
# Explicit browser-visible preview credential approved for this space/endpoint.
# No management token, server credential copy, or tokenless proxy support.
BROWSER_PREVIEW_TOKEN=
BROWSER_PREVIEW_HOST=
# Optional explicit WebSocket endpoint (ws/wss); not derived from the HTTP host.
LIVE_PREVIEW_SESSION_HOST=
# Optional preview package is included only when app-local LIVE_PREVIEW_ENABLED=true.
# Rebuild after changing this flag; a URL session is still required for preview mode.
