<!doctype html>
<html lang="en">
  <head>
    <title>Experiences Node SDK Reference Implementation</title>

    <style>
      html,
      textarea,
      input,
      button {
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          avenir next,
          avenir,
          segoe ui,
          helvetica neue,
          Adwaita Sans,
          Cantarell,
          Ubuntu,
          roboto,
          noto,
          helvetica,
          arial,
          sans-serif;
      }
      h1,
      main {
        display: grid;
        grid-gap: 2rem;
        grid-template-rows: auto 1fr;
        max-width: 1040px;
        margin-inline: auto;
      }
      ol {
        margin: 0;
      }
      summary {
        cursor: pointer;
      }
      a {
        color: inherit;

        &:hover,
        &:active {
          color: blue;
        }
      }
      #experiences > div {
        display: grid;
        grid-gap: 2rem;
        grid-auto-rows: 75dvh;
        justify-items: center;
        align-items: center;
        margin-block-end: 2rem;

        > div {
          display: grid;
          width: 100%;
          height: 100%;
          justify-items: center;
          align-items: center;
          background: #eee;
        }
      }
      .control-panel__fields {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr) auto;
        gap: 0.4rem 1.5rem;
        align-items: center;
        width: 100%;
      }
      .control-panel__row-value {
        min-width: 0;
        overflow-wrap: anywhere;
        white-space: normal;
      }
      .control-panel__row-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }
      @media (max-width: 640px) {
        .control-panel__fields {
          grid-template-columns: max-content minmax(0, 1fr);
          gap: 0.5rem 1rem;
        }
        .control-panel__row-actions {
          grid-column: 1 / -1;
          margin-bottom: 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <h1>Experiences Node SDK Reference Implementation</h1>

    <main>
      <section class="control-panel" aria-label="Utilities">
        <h2 class="control-panel__title">Utilities</h2>

        <div class="control-panel__fields">
          <span class="control-panel__row-label">Live Preview</span>
          <span class="control-panel__row-value"><%= isPreview ? 'Snapshot' : 'Off' %></span>
          <span class="control-panel__row-actions"></span>
          <span class="control-panel__row-label">Identify requested</span>
          <span class="control-panel__row-value"><%= !isPreview && identifyRequested ? 'Yes' : 'No' %></span>
          <span class="control-panel__row-actions">
            <% if (!isPreview && !identifyRequested) { %>
              <a href="/?userId=charles">Identify</a>
            <% } %>
          </span>
        </div>
        <% if (isPreview) { %>
          <p class="control-panel__note">Preview snapshot; no visitor identification</p>
        <% } %>
      </section>

      <section id="experiences">
        <h2>Experiences</h2>

        <div>
          <% for (const { id, plan } of experiences) { %>
            <div data-experience-id="<%= id %>">
              <div>
                <% if (plan) { %>
                  <%- include('nodes', { nodes: plan.nodes }) %>
                <% } else { %>
                  <p role="status">This Experience could not be loaded.</p>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>
