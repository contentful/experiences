<% for (const node of nodes) {
  const props = { ...node.props.design, ...node.props.content, ...node.props.resolved, ...node.slots };
%>
  <article>
    <h3><%= props.title %></h3>
    <% if (props.description) { %>
      <%- documentToHtmlString(props.description.document) %>
    <% } %>
    <% if (props.collection) { %>
      <ol>
        <% for (const item of props.collection) { %>
          <li>
            <strong><%= item.collectionItemTitle %></strong>
            <% if (item.collectionItemDescription) { %>
              <%- documentToHtmlString(item.collectionItemDescription.document) %>
            <% } %>
          </li>
        <% } %>
      </ol>
    <% } %>
    <% for (const children of Object.values(node.slots)) { %>
      <%- include('nodes', { nodes: children }) %>
    <% } %>
  </article>
<% } %>
