{
  "name": "@implementation/experiences-react-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone React reference foundation for Contentful Experiences",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run clean && vite build",
    "dev": "npm run build && tsx server.ts",
    "serve": "npm run build && pm2 start ./node_modules/tsx/dist/cli.mjs --name experiences-react-sdk-app -- server.ts",
    "serve:stop": "pm2 delete experiences-react-sdk-app",
    "restart": "npm run build && pm2 restart experiences-react-sdk-app",
    "status": "pm2 show experiences-react-sdk-app",
    "logs": "pm2 logs experiences-react-sdk-app",
    "clean": "rimraf ./dist ./coverage",
    "lint": "eslint --config eslint.config.ts .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "@contentful/experiences-react": "file:../../pkgs/contentful-experiences-react-local.tgz",
    "@contentful/experiences-web": "file:../../pkgs/contentful-experiences-web-local.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "vite": "6.4.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "pm2": "7.0.4",
    "rimraf": "6.1.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "jiti": "2.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "overrides": {
    "@contentful/experiences-react": "$@contentful/experiences-react",
    "@contentful/experiences-web": "$@contentful/experiences-web",
    "@contentful/experiences-client": "file:../../pkgs/contentful-experiences-client-local.tgz",
    "@contentful/experiences-runtime": "file:../../pkgs/contentful-experiences-runtime-local.tgz",
    "@contentful/experiences-sdk-core": "file:../../pkgs/contentful-experiences-sdk-core-local.tgz",
    "@contentful/experiences-design": "file:../../pkgs/contentful-experiences-design-local.tgz",
    "@contentful/experiences-live-preview": "$@contentful/experiences-live-preview"
  },
  "nx": {
    "includedScripts": []
  },
  "optionalDependencies": {
    "@contentful/experiences-live-preview": "file:../../pkgs/contentful-experiences-live-preview-local.tgz"
  }
}
