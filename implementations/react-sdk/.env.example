# The app starts without credentials; real content loading requires SPACE_ID/CDA_TOKEN.
# Configure only this app's .env.
# CDA_TOKEN must be a Delivery credential approved for browser exposure.
SPACE_ID=
ENVIRONMENT_ID=master
CDA_TOKEN=
LOCALE=en-US
PORT=3400
# Optional comma-separated override; blank uses the three shared reference IDs.
EXPERIENCE_IDS=

# Optional Preview Sessions; disabled builds omit the optional preview chunk.
LIVE_PREVIEW_ENABLED=
# Only a preview credential explicitly approved for browser exposure belongs here.
BROWSER_PREVIEW_TOKEN=
BROWSER_PREVIEW_HOST=
# Local convenience only; copy into preview_session_id in the URL. Code does not read it.
LIVE_PREVIEW_SESSION_ID=
LIVE_PREVIEW_SESSION_HOST=
LIVE_PREVIEW_RESOURCE_RESOLUTION=
