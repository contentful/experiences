# Copy to this implementation's ignored .env; setup preserves existing files.
# CDA_TOKEN is intentionally exposed to the browser at runtime for direct Delivery.
# Use a delivery token scoped for browser use. Never add management credentials.
SPACE_ID=
ENVIRONMENT_ID=master
CDA_TOKEN=
LOCALE=en-US
# Optional comma-separated override of the three shared reference Experience IDs.
# EXPERIENCE_IDS=
PORT=3200

# Optional Preview Session integration. Disabled unless explicitly enabled.
LIVE_PREVIEW_ENABLED=false
# Session/Experience can alternatively be supplied in preview_session_id / preview_experience_id URL parameters.
LIVE_PREVIEW_SESSION_ID=
# Blank binds the first configured/default Experience ID.
LIVE_PREVIEW_EXPERIENCE_ID=
# Optional session-owned resource resolution; no per-fetch locale/parameter overrides.
LIVE_PREVIEW_RESOURCE_RESOLUTION=
# Explicit browser-visible preview credential approved for this space/endpoint.
# No management token, server credential copy, or tokenless proxy support.
BROWSER_PREVIEW_TOKEN=
BROWSER_PREVIEW_HOST=
# Optional explicit WebSocket endpoint (ws/wss); not derived from the HTTP host.
LIVE_PREVIEW_SESSION_HOST=
# Browser code is included only by npm run build:preview / dev:preview etc.
# Deployment flag EXPERIENCES_LIVE_PREVIEW=1 belongs to the build process, not .env.
