{
  "name": "@implementation/experiences-web-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone Web SDK reference implementation for Contentful Experiences",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:assets",
    "build:assets": "tsx scripts/build-assets.ts",
    "dev": "npm run build && tsx server.ts",
    "serve": "npm run build && pm2 start ./node_modules/tsx/dist/cli.mjs --name experiences-web-sdk-app -- server.ts",
    "serve:stop": "pm2 delete experiences-web-sdk-app",
    "restart": "pm2 restart experiences-web-sdk-app",
    "status": "pm2 show experiences-web-sdk-app",
    "logs": "pm2 logs experiences-web-sdk-app",
    "clean": "rimraf ./public/dist ./coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config eslint.config.ts ."
  },
  "dependencies": {
    "@contentful/experiences-web": "file:../../pkgs/contentful-experiences-web-local.tgz",
    "@contentful/rich-text-html-renderer": "17.1.6"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "vite": "6.4.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "pm2": "7.0.4",
    "rimraf": "6.1.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "jiti": "2.6.1",
    "@types/node": "22.20.1"
  },
  "overrides": {
    "@contentful/experiences-web": "$@contentful/experiences-web",
    "@contentful/experiences-client": "file:../../pkgs/contentful-experiences-client-local.tgz",
    "@contentful/experiences-runtime": "file:../../pkgs/contentful-experiences-runtime-local.tgz",
    "@contentful/experiences-sdk-core": "file:../../pkgs/contentful-experiences-sdk-core-local.tgz"
  },
  "nx": {
    "includedScripts": []
  }
}
