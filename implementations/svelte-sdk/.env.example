# Private server Delivery configuration. Never copy CDA_TOKEN into browser configuration.
SPACE_ID=
ENVIRONMENT_ID=master
CDA_TOKEN=
LOCALE=en-US
ORIGIN=http://127.0.0.1:3600
# Optional browser-approved Delivery token; blank uses the restricted same-app proxy.
BROWSER_CDA_TOKEN=
# Optional comma-separated overrides; blank keeps the shared three reference IDs.
EXPERIENCE_IDS=
# Deployment gate. Enable only with both distinct server and browser Preview credentials.
LIVE_PREVIEW_ENABLED=
PREVIEW_TOKEN=
PREVIEW_HOST=
BROWSER_PREVIEW_TOKEN=
BROWSER_PREVIEW_HOST=
LIVE_PREVIEW_SESSION_HOST=
LIVE_PREVIEW_RESOURCE_RESOLUTION=
# Unread convenience value. Copy manually into the URL's preview_session_id.
LIVE_PREVIEW_SESSION_ID=
