{
  "name": "@implementation/experiences-svelte-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone SvelteKit 3 rendering reference for Contentful Experiences",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --host 127.0.0.1 --port 3600 --strictPort",
    "start": "node server.mjs",
    "serve": "npm run build && pm2 start server.mjs --name experiences-svelte-sdk-app",
    "serve:stop": "pm2 delete experiences-svelte-sdk-app",
    "stop": "pm2 delete experiences-svelte-sdk-app",
    "restart": "npm run build && pm2 restart experiences-svelte-sdk-app --update-env",
    "status": "pm2 show experiences-svelte-sdk-app",
    "logs": "pm2 logs experiences-svelte-sdk-app",
    "clean": "rimraf ./build ./.svelte-kit ./coverage",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "node --test src/lib/content.test.mjs"
  },
  "dependencies": {
    "@contentful/experiences-sdk-core": "file:../../pkgs/contentful-experiences-sdk-core-local.tgz",
    "@contentful/experiences-design": "file:../../pkgs/contentful-experiences-design-local.tgz",
    "@contentful/experiences-client": "file:../../pkgs/contentful-experiences-client-local.tgz",
    "@contentful/experiences-runtime": "file:../../pkgs/contentful-experiences-runtime-local.tgz",
    "@contentful/experiences-node": "file:../../pkgs/contentful-experiences-node-local.tgz",
    "@contentful/experiences-web": "file:../../pkgs/contentful-experiences-web-local.tgz",
    "@contentful/experiences-svelte": "file:../../pkgs/contentful-experiences-svelte-local.tgz",
    "@contentful/experiences-live-preview": "file:../../pkgs/contentful-experiences-live-preview-local.tgz",
    "@contentful/rich-text-html-renderer": "17.2.3",
    "@contentful/rich-text-types": "17.2.7",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "svelte-check": "4.7.8",
    "pm2": "7.0.4",
    "rimraf": "6.1.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "@types/node": "22.20.1",
    "contentful": "11.12.10"
  },
  "overrides": {
    "@contentful/experiences-sdk-core": "$@contentful/experiences-sdk-core",
    "@contentful/experiences-design": "$@contentful/experiences-design",
    "@contentful/experiences-client": "$@contentful/experiences-client",
    "@contentful/experiences-runtime": "$@contentful/experiences-runtime",
    "@contentful/experiences-node": "$@contentful/experiences-node",
    "@contentful/experiences-web": "$@contentful/experiences-web",
    "@contentful/experiences-svelte": "$@contentful/experiences-svelte",
    "@contentful/experiences-live-preview": "$@contentful/experiences-live-preview"
  },
  "nx": {
    "includedScripts": []
  }
}
