# Copy this file to .env.local and fill in real values from a Contentful space.
#
# Bootstrap the demo Experience into your space first with:
#   cd examples/scripts && npm run bootstrap
# The script prints the Destination id; paste it into DESTINATION_ID below.

SPACE_ID=
ENVIRONMENT_ID=master

# Destination the root route resolves paths against. Server-generated; the
# bootstrap prints it. Destination delivery is space-scoped (no environment).
DESTINATION_ID=

# Content Delivery API token — used by every route by default.
CDA_TOKEN=

# Content Preview API token — optional for Preview Sessions on /experiences/[id].
CPA_TOKEN=

# Explicit browser configuration for the managed Web owner. These values are
# public in the browser bundle: use approved, scoped credentials and endpoint CORS,
# or configure an authenticated trusted proxy in lib/experience-client.tsx.
# Set the same space/environment as the server; tokens are designated separately.
NEXT_PUBLIC_SPACE_ID=
NEXT_PUBLIC_ENVIRONMENT_ID=master
NEXT_PUBLIC_CDA_TOKEN=
# Optional interactive Preview credential; set alongside server CPA_TOKEN.
NEXT_PUBLIC_CPA_TOKEN=
