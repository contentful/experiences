    "@angular/router": "22.2.4",
    "@angular/ssr": "^22.2.5",
    "@contentful/experiences-angular": "*",
    "@contentful/experiences-web": "*",
    "express": "^5.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@types/express": "^5.0.0",
