# Copy this file to .env and fill in real values from a Contentful space.
#
# Bootstrap the demo Experience into your space first with:
#   cd examples/scripts && npm run bootstrap
# The script prints the Destination id; paste it into DESTINATION_ID below.

SPACE_ID=
ENVIRONMENT_ID=master

# Destination the root route resolves paths against. Server-generated; the
# bootstrap prints it. Destination delivery is space-scoped (no environment).
DESTINATION_ID=

# Private server Content Delivery API token. Never projected into browser data.
CDA_TOKEN=

# Private server Preview credential. Capability is deployment-gated.
CPA_TOKEN=
LIVE_PREVIEW_ENABLED=false

# Browser identity/configuration must match the private server scope above.
# Copy the non-secret IDs explicitly; server tokens are NEVER copied automatically.
PUBLIC_SPACE_ID=
PUBLIC_ENVIRONMENT_ID=master
PUBLIC_DESTINATION_ID=

# Intentionally browser-visible credentials, approved for this use and CORS scope.
# Alternatively configure a real authenticated Delivery/Optimization proxy in
# src/lib/experiences.ts. /_exo/primary is NOT that proxy.
PUBLIC_CDA_TOKEN=
PUBLIC_CPA_TOKEN=
PUBLIC_LIVE_PREVIEW_ENABLED=false
