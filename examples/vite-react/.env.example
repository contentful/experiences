# Copy this file to .env.local and fill in real values from a Contentful space.
#
# Bootstrap the demo Experience into your space first with:
#   cd examples/scripts && npm run bootstrap
# The script prints the Destination id; paste it into VITE_DESTINATION_ID below.
#
# Vite inlines every VITE_* variable into the browser bundle, so anyone who
# loads the app can read these. Use a read-only Content Delivery API token.
# Never put a Content Preview API token here.

VITE_SPACE_ID=
VITE_ENVIRONMENT_ID=master
# Destination the app resolves paths against (server-generated; the bootstrap
# prints it). Destination delivery is space-scoped, so the environment above
# only applies to the /experiences/:id route.
VITE_DESTINATION_ID=
VITE_CDA_TOKEN=
