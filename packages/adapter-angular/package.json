{
  "name": "@contentful/experiences-angular",
  "version": "0.8.4",
  "description": "Angular adapter for Contentful Experiences — Server and Client renderers over a PortableRenderPlan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git",
    "directory": "packages/adapter-angular"
  },
  "scripts": {
    "build": "ngc -p tsconfig.lib.json && publint",
    "test": "vitest run && vitest run -c vitest.ssr.config.ts"
  },
  "dependencies": {
    "@contentful/experiences-client": "0.10.10",
    "@contentful/experiences-runtime": "0.3.4",
    "@contentful/experiences-design": "0.13.8",
    "@contentful/experiences-live-preview": "0.7.10",
    "@contentful/experiences-sdk-core": "0.13.9"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.1.4",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.0.1",
    "publint": "^0.3.25",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "zone.js": "~0.16.3"
  }
}
