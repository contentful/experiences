{
  "name": "@contentful/experiences-svelte",
  "version": "0.13.3",
  "description": "Svelte adapter for Contentful Experiences — Server and Client renderers over a PortableRenderPlan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git",
    "directory": "packages/adapter-svelte"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && publint",
    "test": "vitest run && vitest run -c vitest.ssr.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@contentful/experiences-client": "0.10.9",
    "@contentful/experiences-runtime": "0.3.3",
    "@contentful/experiences-sdk-core": "0.13.8",
    "@contentful/experiences-design": "0.13.7",
    "@contentful/experiences-live-preview": "0.7.9"
  },
  "peerDependencies": {
    "svelte": "^5.55.7"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.0.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6"
  }
}
