{
  "name": "@contentful/experiences-svelte",
  "version": "0.14.1",
  "description": "Svelte adapter for Contentful Experiences — Server and Client renderers over a PortableRenderPlan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./kit/client": {
      "types": "./dist/kit/client.d.ts",
      "svelte": "./dist/kit/client.js",
      "default": "./dist/kit/client.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/test/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git",
    "directory": "packages/adapter-svelte"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && publint",
    "test": "vitest run && vitest run -c vitest.ssr.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@contentful/experiences-client": "0.11.0",
    "@contentful/experiences-design": "0.13.14",
    "@contentful/experiences-live-preview": "0.7.17",
    "@contentful/experiences-runtime": "0.4.1",
    "@contentful/experiences-sdk-core": "0.13.15",
    "@contentful/experiences-web": "0.10.1"
  },
  "peerDependencies": {
    "svelte": "^5.55.7",
    "@sveltejs/kit": "^2.70.4 || ^3.2.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  }
}
