{
  "name": "@contentful/experiences-react",
  "version": "0.16.0",
  "description": "React adapter for Contentful Experiences \u2014 Server and Client renderers over a PortableRenderPlan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./custom-renderer": {
      "import": {
        "types": "./dist/custom-renderer.d.ts",
        "default": "./dist/custom-renderer.js"
      }
    },
    "./package.json": "./package.json",
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      }
    },
    "./web-sdk": {
      "import": {
        "types": "./dist/web-sdk.d.ts",
        "default": "./dist/web-sdk.js"
      }
    },
    "./router/react-router": {
      "import": {
        "types": "./dist/router/react-router.d.ts",
        "default": "./dist/router/react-router.js"
      }
    },
    "./router/tanstack-router": {
      "import": {
        "types": "./dist/router/tanstack-router.d.ts",
        "default": "./dist/router/tanstack-router.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git",
    "directory": "packages/adapter-react"
  },
  "dependencies": {
    "@contentful/experiences-client": "0.10.16",
    "@contentful/experiences-runtime": "0.4.0",
    "@contentful/experiences-sdk-core": "0.13.14",
    "@contentful/experiences-design": "0.13.13",
    "@contentful/experiences-web": "0.10.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "@contentful/experiences-live-preview": "0.7.16",
    "react-router-dom": "^7.18.4",
    "@tanstack/react-router": "^1.168.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.4.0 || ^7.0.0",
    "@tanstack/react-router": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    }
  }
}
