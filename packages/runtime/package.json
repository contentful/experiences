{
  "name": "@contentful/experiences-runtime",
  "version": "0.2.2",
  "description": "Shared runtime and event construction for Contentful Experiences",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git",
    "directory": "packages/runtime"
  },
  "dependencies": {
    "@contentful/experiences-client": "0.10.2",
    "@contentful/experiences-sdk-core": "0.13.1",
    "@contentful/optimization-api-client": "^2.2.1",
    "es-toolkit": "^1.52.0",
    "zod": "^4.6.7"
  }
}
