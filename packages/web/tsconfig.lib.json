{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/test-fixtures/**/*",
    "vitest.config.ts",
    "vitest.ssr.config.ts",
    "tsup.config.ts"
  ]
}
