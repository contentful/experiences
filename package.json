{
  "name": "@contentful/experiences-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Nx workspace for the Contentful Experience Orchestration (ExO) SDK suite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git"
  },
  "bugs": {
    "url": "https://github.com/contentful/experiences/issues"
  },
  "homepage": "https://github.com/contentful/experiences#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "lib/mocks"
  ],
  "scripts": {
    "build": "nx run-many -t build --exclude=tag:scope:implementation",
    "test": "nx run-many -t test --exclude=tag:scope:implementation",
    "lint": "nx run-many -t lint --exclude=tag:scope:implementation",
    "typecheck": "nx run-many -t typecheck --exclude=tag:scope:implementation",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "graph": "nx graph",
    "release": "nx release",
    "release:dry": "nx release --dry-run",
    "mocks:clean": "nx run mocks:clean",
    "mocks:config:ctfl:list": "nx run mocks:config:ctfl:list",
    "mocks:fetch:ctfl:space": "nx run mocks:fetch:ctfl:space",
    "mocks:fetch:ctfl:experiences": "nx run mocks:fetch:ctfl:experiences",
    "mocks:fetch:ctfl": "nx run mocks:fetch:ctfl",
    "mocks:generate:ctfl:types": "nx run mocks:generate:ctfl:types",
    "mocks:upload:ctfl:space": "nx run mocks:upload:ctfl:space",
    "mocks:upload:ctfl:space:confirmed": "nx run mocks:upload:ctfl:space:confirmed",
    "mocks:typecheck": "nx run mocks:typecheck",
    "mocks:lint": "nx run mocks:lint",
    "mocks:test:unit": "nx run mocks:test:unit",
    "prepare": "husky install",
    "pack:pkgs": "nx run-many -t pack --projects='packages/*'",
    "build:pkgs": "npm run pack:pkgs --",
    "pm2:list": "pm2 list",
    "pm2:logs": "pm2 logs",
    "pm2:stop:all": "pm2 stop all",
    "pm2:delete:all": "pm2 delete all"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^23.3.0",
    "@nx/js": "^23.3.0",
    "@nx/vite": "^23.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "^23.3.0",
    "pm2": "7.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
