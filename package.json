{
  "name": "@contentful/experiences-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Nx workspace for the Contentful Experience Orchestration (ExO) SDK suite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/experiences.git"
  },
  "bugs": {
    "url": "https://github.com/contentful/experiences/issues"
  },
  "homepage": "https://github.com/contentful/experiences#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "test-apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "graph": "nx graph",
    "release": "nx release",
    "release:dry": "nx release --dry-run",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^23.1.1",
    "@nx/js": "^23.1.1",
    "@nx/vite": "^23.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
